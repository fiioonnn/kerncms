# Production environment for docker-compose.prod.yml. Copy to .env.prod (never commit it).
# Secrets: one value per line, each different. `openssl rand -hex 32` gives URL-safe values.

# Public address of the CMS (invite links, login, preview overlay, media URLs).
KERN_PUBLIC_URL=https://app.kerncms.com
# kerncms is invite-only. Only this address can sign up (as admin); everyone else needs an invite.
KERN_ADMIN_EMAIL=
# Anonymous visitor hashes (analytics). Never change it once set.
KERN_SECRET=

# Postgres (only reachable inside Docker)
POSTGRES_USER=kern
POSTGRES_PASSWORD=
POSTGRES_DB=kern

# Media storage (RustFS, only reachable inside Docker)
S3_ACCESS_KEY=kernadmin
S3_SECRET_KEY=
S3_BUCKET=kern
S3_REGION=us-east-1

# Mail (login codes, invites, form notifications). Spacemail: port 465 with smtps.
# Encode @ in the user name as %40 and special characters in the password.
SMTP_URL=smtps://noreply%40kerncms.com:PASSWORT@mail.spacemail.com:465
MAIL_FROM=kerncms <noreply@kerncms.com>

# Previews in the visual editor: https://preview-<site>.kerncms.com. Needs a proxied DNS record *.kerncms.com.
KERN_PREVIEW_DOMAIN=kerncms.com

# Customer domains (cms.kundendomain.de) via Cloudflare for SaaS, optional.
# Token: Cloudflare → My Profile → API Tokens → custom token, Zone · SSL and Certificates · Edit, zone kerncms.com.
CLOUDFLARE_API_TOKEN=
# Zone ID of kerncms.com (right column on the zone's overview page)
CLOUDFLARE_ZONE_ID=
# Where customers point their CNAME
KERN_CUSTOM_DOMAIN_TARGET=customers.kerncms.com

# Google, optional. Shown in the editor's SEO tab and on the statistics page.
# PageSpeed Insights API (Google Cloud): loading time and quality scores of the live pages.
PAGESPEED_API_KEY=
# Places API (New) (Google Cloud): position on Google Maps for each page's focus keyword.
GOOGLE_MAPS_API_KEY=
# Serper (serper.dev): position in the normal Google results for each page's focus keyword.
SERPER_API_KEY=


# Optional: Cloudflare Tunnel (profile "tunnel")
CLOUDFLARE_TUNNEL_TOKEN=
