{
  "name": "kerncms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm services:up && pnpm db:migrate && next dev",
    "services:up": "docker compose up -d --wait postgres storage mailpit && docker compose run --rm --quiet-pull storage-init",
    "services:down": "docker compose stop",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@base-ui/react": "^1.9.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@tiptap/extension-document": "3.33.1",
    "@tiptap/extension-hard-break": "3.33.1",
    "@tiptap/extension-link": "^3.33.1",
    "@tiptap/extension-paragraph": "3.33.1",
    "@tiptap/extension-text": "3.33.1",
    "@tiptap/extensions": "3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "htmlparser2": "^10.1.0",
    "lucide-react": "^1.71.0",
    "marked": "^18.2.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "openai": "^7.55.0",
    "postgres": "^4.1.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "turndown": "^7.2.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.18.0"
}
