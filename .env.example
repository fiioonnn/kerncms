# Postgres
POSTGRES_USER=kern
POSTGRES_PASSWORD=kern
POSTGRES_DB=kern
POSTGRES_PORT=5432
DATABASE_URL=postgres://kern:kern@localhost:5432/kern

# S3 storage (RustFS, S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=kernadmin
S3_SECRET_KEY=kernadmin-secret
S3_BUCKET=kern
S3_PORT=9000
S3_CONSOLE_PORT=9001

# App
APP_PORT=3000

# kerncms
# Secret for anonymous visitor hashes (analytics). Any long random string.
KERN_SECRET=change-me
# kerncms is invite-only. This address may create the first account and is always an admin.
# Without it, only in development the very first person to sign in becomes admin.
KERN_ADMIN_EMAIL=
# Public URL of the CMS, used in invite links and for the preview overlay.
KERN_PUBLIC_URL=http://localhost:3000

# Mail (login codes, invites). Locally Mailpit catches everything: http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=kerncms <noreply@kerncms.com>
# Preview servers listen on the local network so phones can open them (QR code in the editor). Set to 0 to keep them local.
KERN_PREVIEW_LAN=1

# Customer domains (cms.kundendomain.de) via Cloudflare for SaaS, optional.
# Without them a domain is only stored. Locally test with e.g. kunde.localhost.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# KERN_CUSTOM_DOMAIN_TARGET=customers.kerncms.com

# Google, optional. Shown in the editor's SEO tab and on the statistics page.
# PageSpeed Insights API: loading time and quality scores of the live pages.
# PAGESPEED_API_KEY=
# Places API (New): position on Google Maps for each page's focus keyword, rating of the business.
# GOOGLE_MAPS_API_KEY=
# Serper (serper.dev): position in the normal Google results for each page's focus keyword.
# SERPER_API_KEY=
