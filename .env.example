# Postgres
POSTGRES_USER=kern
POSTGRES_PASSWORD=kern
POSTGRES_DB=kern
POSTGRES_PORT=5432
DATABASE_URL=postgres://kern:kern@localhost:5432/kern

# S3 storage (RustFS, S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=kernadmin
S3_SECRET_KEY=kernadmin-secret
S3_BUCKET=kern
S3_PORT=9000
S3_CONSOLE_PORT=9001

# App
APP_PORT=3000

# kerncms
# Secret for anonymous visitor hashes (analytics). Any long random string.
KERN_SECRET=change-me
# Public URL of the CMS, used in invite links and for the preview overlay.
KERN_PUBLIC_URL=http://localhost:3000

# Mail (login codes, invites). Locally Mailpit catches everything: http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=kerncms <cms@kerncms.local>
